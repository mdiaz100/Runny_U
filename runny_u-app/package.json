{
  "name": "runny-u-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "cucumber-js",
    "test:e2e:headed": "HEADLESS=false cucumber-js",
    "test:e2e:cart": "cucumber-js --tags '@cart'",
    "test:e2e:report": "serenity-bdd run",
    "test:e2e:open-report": "serenity-bdd run && open target/site/serenity/index.html",
    "playwright:install": "npx playwright install",
    "test:e2e:debug": "cucumber-js --tags '@test-simple'",
    "cy:open": "cypress open",
  "cy:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.22.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.1",
    "@angular/cli": "^19.2.1",
    "@angular/compiler-cli": "^19.2.0",
    "@badeball/cypress-cucumber-preprocessor": "^23.2.1",
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.56.1",
    "@serenity-js/assertions": "^3.35.2",
    "@serenity-js/console-reporter": "^3.35.2",
    "@serenity-js/core": "^3.35.2",
    "@serenity-js/cucumber": "^3.35.2",
    "@serenity-js/playwright": "^3.35.2",
    "@serenity-js/rest": "^3.35.2",
    "@serenity-js/serenity-bdd": "^3.35.2",
    "@serenity-js/web": "^3.35.2",
    "@types/cucumber": "^6.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.9.2",
    "cucumber-html-reporter": "^7.2.0",
    "cypress": "^15.5.0",
    "cypress-esbuild-preprocessor": "^1.0.2",
    "jasmine-core": "~5.6.0",
    "jasmine-marbles": "^0.9.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  }
}
